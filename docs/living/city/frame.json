width": null, "pts": [[3708.3, 3659.9], [3822.3, 3649.9], [3827.3, 3704.9], [3714.3, 3714.9]], "history": [{"year": 1, "text": "The first great church rises beside the old citadel."}, {"year": 1, "text": "17 houses were pulled down to make room."}]}, {"id": "granary_founder", "type": "granary", "name": "Granary of the Founder", "built": 1, "destroyed": null, "xy": [2403.3, 4322.9], "geom": "polygon", "width": null, "pts": [[2343.3, 4290.9], [2457.3, 4282.9], [2462.3, 4353.9], [2349.3, 4361.9]], "history": [{"year": 1, "text": "Egyptian grain needs a home."}]}, {"id": "cistern_founder", "type": "cistern", "name": "Cistern of the Founder", "built": 1, "destroyed": null, "xy": [2957.3, 3923.9], "geom": "polygon", "width": null, "pts": [[2916.3, 3894.9], [2991.3, 3886.9], [2998.3, 3953.9], [2923.3, 3960.9]], "history": [{"year": 1, "text": "A covered cistern under brick vaults."}]}, {"id": "r_north1", "type": "road", "name": "Street of the Coppersmiths", "built": 1, "destroyed": null, "xy": [2669.3, 3021.9], "geom": "line", "width": 1.2, "pts": [[2730.3, 3653.9], [2673.3, 3099.9], [2616.3, 2388.9]], "history": [{"year": 1, "text": "A street runs north from the forum to the Horn."}]}, {"id": "nymphaeum_great", "type": "cistern", "name": "Great Nymphaeum", "built": 11, "destroyed": null, "xy": [2317.3, 3085.9], "geom": "polygon", "width": null, "pts": [[2280.3, 3049.9], [2364.3, 3065.9], [2354.3, 3120.9], [2270.3, 3104.9]], "history": [{"year": 11, "text": "At the aqueduct's end a fountain house and reservoir feed the public fountains."}]}, {"id": "harbor_neorion", "type": "harbor", "name": "Neorion Harbor", "built": 11, "destroyed": null, "xy": [2914.3, 2402.9], "geom": "polygon", "width": null, "pts": [[2758.3, 2274.9], [3071.3, 2274.9], [3071.3, 2530.9], [2758.3, 2530.9]], "history": [{"year": 11, "text": "Ships from the Black Sea unload in the calm of the Horn, west of the old landing."}]}, {"id": "warehouse_horn", "type": "warehouse", "name": "Horrea of the Horn", "built": 11, "destroyed": null, "xy": [2787.3, 2630.9], "geom": "polygon", "width": null, "pts": [[2730.3, 2601.9], [2843.3, 2601.9], [2843.3, 2658.9], [2730.3, 2658.9]], "history": [{"year": 11, "text": "Warehouses behind the new quay."}, {"year": 11, "text": "5 houses were pulled down to make room."}]}, {"id": "tower_horn", "type": "fort", "name": "Tower of the Horn", "built": 24, "destroyed": null, "xy": [3099.3, 2573.9], "geom": "polygon", "width": null, "pts": [[3078.3, 2551.9], [3121.3, 2551.9], [3121.3, 2594.9], [3078.3, 2594.9]], "history": [{"year": 24, "text": "A watchtower over the Neorion, where the Black Sea grain ships now lie."}]}, {"id": "church_megale", "type": "church", "name": "The Great Church", "built": 30, "destroyed": null, "xy": [3654.3, 3767.9], "geom": "polygon", "width": null, "pts": [[3556.3, 3730.9], [3738.3, 3704.9], [3752.3, 3804.9], [3570.3, 3830.9]], "history": [{"year": 30, "text": "Beside the church of Holy Peace the bishops raise the Great Church, a timber-roofed basilica longer than any hall in the city. Its foundations are laid with blocks taken from the old Greek wall of Byzas, pulled down when the Founder's wall was built."}, {"year": 30, "text": "44 houses were pulled down to make room."}]}, {"id": "horrea_troadensia", "type": "granary", "name": "Horrea Troadensia", "built": 46, "destroyed": null, "xy": [2872.3, 2843.9], "geom": "polygon", "width": null, "pts": [[2805.3, 2820.9], [2933.3, 2809.9], [2939.3, 2866.9], [2811.3, 2877.9]], "history": [{"year": 46, "text": "Granaries on the Golden Horn for the grain ships from the Troad, behind the Neorion quays."}, {"year": 46, "text": "16 houses were pulled down to make room."}]}, {"id": "church_anastasia", "type": "church", "name": "Anastasia", "built": 49, "destroyed": null, "xy": [2659.3, 3895.9], "geom": "polygon", "width": null, "pts": [[2630.3, 3874.9], [2687.3, 3874.9], [2687.3, 3916.9], [2630.3, 3916.9]], "history": [{"year": 49, "text": "In a house chapel south of the Mese, Gregory of Nazianzus preaches to the Nicene remnant; the chapel is called Anastasia, the resurrection."}, {"year": 49, "text": "8 houses were pulled down to make room."}]}, {"id": "aqb_valley", "type": "aqueduct_bridge", "name": "Bridge of the Aqueduct", "built": 11, "destroyed": null, "xy": [1368.3, 2740.7], "geom": "polygon", "width": null, "pts": [[1460.3, 2809.7], [1677.3, 2853.7], [1682.3, 2833.7], [1467.3, 2790.7], [1067.3, 2589.7], [1059.3, 2606.7]], "history": [{"year": 11, "text": "Where the ground falls away under the channel, an arcade of stone 560 m long carries it."}, {"year": 11, "text": "3 houses were pulled down to make room."}]}, {"id": "baths_constantius", "type": "baths", "name": "Baths of Constantius", "built": 25, "destroyed": null, "xy": [455.3, 2644.7], "geom": "polygon", "width": null, "pts": [[386.3, 2623.7], [493.3, 2584.7], [523.3, 2665.7], [416.3, 2704.7]], "history": [{"year": 25, "text": "Now that the Great Aqueduct runs full, the emperor gives the fourth hill public baths, a domed hall beside the Holy Apostles."}]}, {"id": "cistern_modestus", "type": "cistern", "name": "Cistern of Modestus", "built": 41, "destroyed": null, "xy": [440.3, 2431.7], "geom": "polygon", "width": null, "pts": [[376.3, 2381.7], [504.3, 2381.7], [504.3, 2480.7], [376.3, 2480.7]], "history": [{"year": 41, "text": "The prefect Modestus digs an open reservoir beside the Holy Apostles, fed from the Great Aqueduct before it enters the city."}]}, {"id": "barracks_gate", "type": "barracks", "name": "Barracks of the Gate", "built": 11, "destroyed": null, "xy": [170.2, 4109.0], "geom": "polygon", "width": null, "pts": [[108.2, 4084.0], [220.2, 4064.0], [233.2, 4135.0], [121.2, 4155.0]], "history": [{"year": 11, "text": "The guard of the land gate needs quarters."}]}, {"id": "cistern_carriers", "type": "cistern", "name": "Cistern of the Water-Carriers", "built": 54, "destroyed": null, "xy": [227.2, 3697.0], "geom": "polygon", "width": null, "pts": [[178.2, 3661.0], [277.2, 3661.0], [277.2, 3732.0], [178.2, 3732.0]], "history": [{"year": 54, "text": "The water-carriers of the dry hill pool their coppers for a cistern halfway up the slope, so they no longer climb from Modestus with every jar."}, {"year": 54, "text": "17 houses were pulled down to make room."}]}, {"id": "r_carriers", "type": "road", "name": "Carriers' Steps", "built": 62, "destroyed": null, "xy": [341.2, 3604.0], "geom": "line", "width": 1.2, "pts": [[341.2, 3853.0], [341.2, 3356.0]], "history": [{"year": 62, "text": "A stepped lane from the Mese straight up the middle of the hill, so a carrier no longer threads between houses with a full jar."}, {"year": 62, "text": "40 houses were pulled down to make room."}]}]}