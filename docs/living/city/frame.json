oad", "name": "Northern Mese", "built": 11, "destroyed": null, "xy": [985.3, 3005.4], "geom": "line", "width": 1.8, "pts": [[1251.3, 3625.4], [1123.3, 3241.4], [910.3, 2815.4], [654.3, 2417.4]], "history": [{"year": 11, "text": "At the Philadelphion the Mese forks; the northern branch climbs to the fourth hill."}, {"year": 11, "text": "20 houses were pulled down to make room."}]}, {"id": "harbor_theodosius", "type": "harbor", "name": "Harbor of Theodosius", "built": 33, "destroyed": null, "xy": [910.3, 4720.4], "geom": "polygon", "width": null, "pts": [[753.3, 4621.4], [1066.3, 4621.4], [1066.3, 4820.4], [753.3, 4820.4]], "history": [{"year": 33, "text": "The Egyptian grain fleet needs a harbor on the Marmara shore big enough for the whole convoy; the merchants dig one west of the Julian harbor."}, {"year": 33, "text": "3 houses were pulled down to make room."}]}, {"id": "horrea_theodosius", "type": "granary", "name": "Horrea of Theodosius", "built": 34, "destroyed": null, "xy": [881.3, 4450.4], "geom": "polygon", "width": null, "pts": [[810.3, 4414.4], [952.3, 4414.4], [952.3, 4486.4], [810.3, 4486.4]], "history": [{"year": 34, "text": "Behind the new harbor the emperor builds state granaries for the annona, the free bread of the city."}, {"year": 34, "text": "8 houses were pulled down to make room."}]}, {"id": "d_xerolophos", "type": "district", "name": "Xerolophos quarter", "built": 42, "destroyed": null, "xy": [319.3, 3289.4], "geom": "polygon", "width": null, "pts": [[0.3, 3895.4], [512.3, 3839.4], [512.3, 2531.4], [298.3, 2531.4], [0.3, 3895.4]], "history": [{"year": 42, "text": "Between the Founder's wall and the old forum quarter the dry seventh hill fills with houses."}]}, {"id": "nymphaeum_maius", "type": "monument", "name": "Nymphaeum Maius", "built": 44, "destroyed": null, "xy": [1990.3, 3412.4], "geom": "polygon", "width": null, "pts": [[1952.3, 3398.4], [2022.3, 3385.4], [2029.3, 3426.4], [1959.3, 3439.4]], "history": [{"year": 44, "text": "Valens finishes the aqueduct's showpiece: a great fountain on the Forum Tauri where the water is seen to arrive."}, {"year": 44, "text": "6 houses were pulled down to make room."}]}, {"id": "horrea_alexandrina", "type": "granary", "name": "Horrea Alexandrina", "built": 55, "destroyed": null, "xy": [1080.3, 4535.4], "geom": "polygon", "width": null, "pts": [[1016.3, 4507.4], [1144.3, 4507.4], [1144.3, 4564.4], [1016.3, 4564.4]], "history": [{"year": 55, "text": "Grain merchants buy the burned lots by the Harbor of Theodosius and raise a granary for the Egyptian ships."}, {"year": 55, "text": "5 houses were pulled down to make room."}]}, {"id": "forum_theodosius", "type": "forum", "name": "Forum of Theodosius", "built": 57, "destroyed": null, "xy": [1848.3, 3526.4], "geom": "polygon", "width": null, "pts": [[1777.3, 3469.4], [1919.3, 3469.4], [1919.3, 3583.4], [1777.3, 3583.4]], "history": [{"year": 57, "text": "Theodosius lays out a great forum on the Forum Tauri, beside the fountain where Valens' water arrives."}, {"year": 57, "text": "29 houses were pulled down to make room."}]}, {"id": "cistern_slope", "type": "cistern", "name": "Second Cistern of the Water-Carriers", "built": 62, "destroyed": null, "xy": [341.3, 3313.4], "geom": "polygon", "width": null, "pts": [[298.3, 3277.4], [384.3, 3277.4], [384.3, 3348.4], [298.3, 3348.4]], "history": [{"year": 62, "text": "The water-carriers' first cistern (AF 54) sits at the foot of the hill and the queue there runs till dark; the families of the upper slope pool their coppers again for a second cistern at the head of the new steps."}, {"year": 62, "text": "15 houses were pulled down to make room."}]}, {"id": "xenon_xerolophos", "type": "monastery", "name": "House of the Widows and Orphans", "built": 65, "destroyed": null, "xy": [398.3, 3711.4], "geom": "polygon", "width": null, "pts": [[362.3, 3682.4], [433.3, 3682.4], [433.3, 3739.4], [362.3, 3739.4]], "history": [{"year": 65, "text": "On the hill one household in seven has no grown man left and small children at home. Neighbours and the monks who took in their sons build a house where widows bake for the street and orphans learn a trade."}, {"year": 65, "text": "13 houses were pulled down to make room."}]}, {"id": "wall_founder", "type": "wall", "name": "Wall of the Founder", "built": 1, "destroyed": null, "xy": [169.2, 2986.9], "geom": "line", "width": null, "pts": [[654.2, 824.9], [-315.8, 5148.9]], "history": [{"year": 1, "text": "The Founder walks the line of the new wall with a spear, 'until he who walks before me stops.'"}]}, {"id": "aq_great", "type": "aqueduct", "name": "Great Aqueduct", "built": 11, "destroyed": null, "xy": [-798.8, 1838.9], "geom": "line", "width": null, "pts": [[-3924.8, 824.9], [-2345.8, 1492.9], [-454.8, 1478.9], [-355.8, 1876.9], [1464.2, 2800.9], [1891.2, 2885.9], [2261.2, 3028.9]], "history": [{"year": 11, "text": "Water is the binding limit: the old channel and one cistern serve 43,000. A new channel from springs in the Thracian hills, 62 m above the sea, falls evenly to the third hill."}, {"year": 11, "text": "6 houses were pulled down to make room."}]}, {"id": "church_apostles", "type": "church", "name": "Church of the Holy Apostles", "built": 11, "destroyed": null, "xy": [624.2, 2257.9], "geom": "polygon", "width": null, "pts": [[608.2, 2207.9], [640.2, 2207.9], [640.2, 2241.9], [674.2, 2241.9], [674.2, 2273.9], [640.2, 2273.9], [640.2, 2307.9], [608.2, 2307.9], [608.2, 2273.9], [574.2, 2273.9], [574.2, 2241.9], [608.2, 2241.9]], "history": [{"year": 11, "text": "A cross-shaped church on the fourth hill, raised as a mausoleum for the Founder."}]}, {"id": "r_firebreak", "type": "road", "name": "Street of the Embers", "built": 22, "destroyed": null, "xy": [1479.2, 2196.9], "geom": "line", "width": 1.6, "pts": [[1080.2, 2203.9], [1507.2, 2189.9], [1877.2, 2203.9]], "history": [{"year": 22, "text": "After the fire of year 19 the people of the north slope cut a broad street through the ashes, so that flames could not leap from roof to roof again."}, {"year": 22, "text": "9 houses were pulled down to make room."}]}, {"id": "market_embers", "type": "market", "name": "Market of the Embers", "built": 23, "destroyed": null, "xy": [1933.2, 2075.9], "geom": "polygon", "width": null, "pts": [[1862.2, 2054.9], [2005.2, 2054.9], [2005.2, 2096.9], [1862.2, 2096.9]], "history": [{"year": 23, "text": "On the burned ground beside the Horn the merchants set up a covered row of shops instead of houses."}]}, {"id": "gate_old_thracian", "type": "gate", "name": "Thracian Gate", "built": -657, "destroyed": 1, "xy": [3209.3, 3750.9], "geom": "polygon", "width": null, "pts": [[3180.3, 3722.9], [3237.3, 3722.9], [3237.3, 3778.9], [3180.3, 3778.9]], "history": [{"year": -657, "text": "The single landward gate."}, {"year": 1, "text": "Demolished: The old gate falls with its wall."}]}, {"id": "fort_acropolis", "type": "fort", "name": "Acropolis of Byzas", "built": -657, "destroyed": null, "xy": [4035.3, 3355.9], "geom": "polygon", "width": null, "pts": [[3867.3, 3212.9], [4180.3, 3184.9], [4208.3, 3483.9], [3896.3, 3540.9]], "history": [{"year": -657, "text": "Megarian settlers under Byzas fortify the headland."}]}, {"id": "harbor_prosphorion", "type": "harbor", "name": "Prosphorion Harbor", "built": -657, "destroyed": null, "xy": [3384.3, 2665.9], "geom": "polygon", "width": null, "pts": [[3185.3, 2800.9], [3185.3, 2530.9], [3583.3, 2530.9], [3583.3, 2800.9]], "history": [{"year": -657, "text": "The sheltered Horn becomes the town's landing."}]}, {"id": "r_old_harbor", "type": "road", "name": "Harbor Lane", "built": -657, "destroyed": null, "xy": [3405.3, 3235.9], "geom": "line", "width": 1.5, "pts": [[3355.3, 2843.9], [3398.3, 3241.9], [3469.3, 3625.9]], "history": [{"year": -657, "text": "A lane climbs from the landing to the market."}]}, {"id": "r_acropolis", "type": "road", "name": "Acropolis Way", "built": -657, "destroyed": null, "xy": [3647.3, 3554.9], "geom": "line", "width": 1.5, "pts": [[3469.3, 3625.9], [3682.3, 3540.9], [3824.3, 3483.9]], "history": [{"year": -657, "text": "A path to the citadel gate."}]}, {"id": "r_south", "type": "road", "name": "South Lane", "built": -657, "destroyed": null, "xy": [3483.3, 3788.9], "geom": "line", "width": 1.5, "pts": [[3469.3, 3625.9], [3497.3, 3952.9]], "history": [{"year": -657, "text": "A lane towards the southern slope."}]}, {"id": "r_east", "type": "road", "name": "Lane of the Fishermen", "built": -657, "destroyed": null, "xy": [3833.3, 3895.9], "geom": "line", "width": 1.2, "pts": [[3497.3, 3838.9], [3896.3, 3881.9], [4152.3, 4009.9]], "history": [{"year": -657, "text": "A lane to the fishing coves."}]}, {"id": "wall_byzas", "type": "wall", "name": "Wall of Byzas", "built": -657, "destroyed": 1, "xy": [3174.3, 3581.9], "geom": "line", "width": null, "pts": [[2957.3, 2530.9], [3391.3, 4632.9]], "history": [{"year": -657, "text": "A wall of rough stone seals the headland."}, {"year": 1, "text": "Demolished: The old wall is too small for an imperial city; its stones go into the new one."}]}, {"id": "agora_tetrastoon", "type": "forum", "name": "Agora (Tetrastoon)", "built": -657, "destroyed": null, "xy": [3554.3, 3696.9], "geom": "polygon", "width": null, "pts": [[3507.3, 3666.9], [3591.3, 3655.9], [3601.3, 3726.9], [3517.3, 3737.9]], "history": [{"year": -657, "text": "The market square where four porticoes meet."}]}, {"id": "d_byzas", "type": "district", "name": "Old Byzas", "built": -657, "destroyed": null, "xy": [3742.3, 3480.9], "geom": "polygon", "width": null, "pts": [[3242.3, 3952.9], [3432.3, 4606.9], [3543.3, 4600.9], [3641.3, 4575.9], [3761.3, 4506.9], [3819.3, 4452.9], [3952.3, 4259.9], [3954.3, 4258.9], [3957.3, 4255.9], [3958.3, 4253.9], [4166.3, 4090.9], [4216.3, 4024.9], [4241.3, 3975.9], [4297.3, 3764.9], [4298.3, 3761.9], [4393.3, 3524.9], [4413.3, 3168.9], [4370.3, 3038.9], [4369.3, 3033.9], [4302.3, 2691.9], [4183.3, 2587.9], [4166.3, 2583.9], [4163.3, 2583.9], [4160.3, 2581.9], [4157